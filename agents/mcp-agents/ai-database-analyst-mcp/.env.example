# ===========================================================
# AI Database Analyst MCP Agent — Environment Configuration
# Copy this file to `.env` and fill in your values.
# ===========================================================

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=4096

# --- Default Database Connection (optional) ---
# Supported DB_TYPE values: sqlite | mysql | postgresql | duckdb
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=sample_data/northwind.db

# --- Safety ---
# When false, write statements (INSERT/UPDATE/DELETE/DROP/...) are blocked.
READ_ONLY_MODE=true

# --- Engine / Pooling ---
POOL_SIZE=5
MAX_OVERFLOW=10
POOL_TIMEOUT=30
CONNECT_TIMEOUT=10
QUERY_TIMEOUT=30
MAX_RESULT_ROWS=10000

# --- Application ---
APP_THEME=dark
CHART_THEME=plotly_dark
AUTO_EXPLAIN_SQL=true
AUTO_GENERATE_CHARTS=true
LOG_LEVEL=INFO
EXPORT_DIR=exports
LOG_DIR=logs
