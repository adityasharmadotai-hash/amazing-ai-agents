# ── WhatsApp Manager Agent — environment variables ───────────────────────────
# Copy this file to `.env` (local) or paste the keys into your host's secret
# manager (Streamlit Cloud → Settings → Secrets, Railway/Render → Variables).
# See Tutorial.md for a step-by-step walkthrough of where each value comes from.

# ── Gemini (the conversation brain) ──────────────────────────────────────────
# Google AI Studio key  →  https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_key

# ── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# From developers.facebook.com → your App → WhatsApp → API Setup.
# Access token: a permanent System-User token with `whatsapp_business_messaging`
# + `whatsapp_business_management`. (The 24h test token works for a first try.)
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_token

# The Phone Number ID of your WhatsApp Business number (NOT the phone number).
WHATSAPP_PHONE_NUMBER_ID=1234567890

# Optional — used only for template/management calls.
WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890

# A secret string YOU invent. You type the same value into the Meta webhook
# config ("Verify token") so Meta and this app can prove they match.
WHATSAPP_VERIFY_TOKEN=make_up_any_long_random_string

# Optional — Meta App Secret. If set, inbound webhooks are signature-verified
# (recommended in production so nobody can POST fake messages to you).
WHATSAPP_APP_SECRET=your_meta_app_secret

# ── Escalation: notify the team on WhatsApp ──────────────────────────────────
# Comma-separated phone numbers (E.164, no +) that get pinged when the agent
# can't answer — e.g. Aditya's number. First one is treated as the primary.
TEAM_WHATSAPP_NUMBERS=15551234567

# ── QR bot (wa-bot/) options — read from the environment by the Node bot ──────
# The WhatsApp group the bot posts escalations to (bot's number must be a member).
TEAM_GROUP_NAME=AX Reply

# Logout alerts — pinged if the bot LOGS OUT (WhatsApp can't warn you then).
# Option 1 (Telegram): create a bot via @BotFather, add it to your group, get the
# group's chat id (negative number). Both values below required for Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Option 2 (Discord/Slack/custom): a channel/incoming-webhook URL. Optional.
ALERT_WEBHOOK_URL=
