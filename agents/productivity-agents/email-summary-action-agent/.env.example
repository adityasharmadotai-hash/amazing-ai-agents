# Copy this file to `.env` and fill in your values.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Google OAuth ---
# Download credentials.json from Google Cloud Console (Desktop OAuth client)
# and place it in the project root. These paths usually don't need changing.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=data/token.json

# --- Google Sheet ---
# Leave SHEET_ID blank to auto-create a sheet on first run.
SHEET_ID=
SHEET_TITLE=Email Action Items

# --- Behavior ---
MAX_EMAILS=25
DEFAULT_LABEL=INBOX
DAILY_RUN_TIME=08:00
DB_PATH=data/emails.db
