# ── Instagram AI Ad Manager — environment variables ──────────────────────────
# Copy this file to `.env` (local) or paste the keys into Streamlit Cloud
# "Secrets" (Settings → Secrets) when deploying.

# Google AI Studio key for Gemini 2.5 Pro  →  https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_key

# ── Meta (Instagram) Marketing API ───────────────────────────────────────────
# A long-lived access token with `ads_read` + `leads_retrieval` permissions.
# See Tutorial.md for the step-by-step token walkthrough.
META_ACCESS_TOKEN=your_long_lived_meta_token

# Your ad account id, WITH the `act_` prefix, e.g. act_1234567890
META_AD_ACCOUNT_ID=act_1234567890
