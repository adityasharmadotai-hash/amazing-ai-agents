# ==========================================================================
#  AI Executive Email Assistant — environment configuration
#  Copy this file to `.env` and fill in your values. Never commit `.env`.
# ==========================================================================

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.3

# ---- Google OAuth ----
# Either set client id + secret here ...
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# ... OR point to a downloaded OAuth client_secret.json (leave blank if using id/secret)
GOOGLE_CLIENT_SECRETS_FILE=
# Must EXACTLY match an Authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8501

# ---- App ----
APP_TITLE=AI Executive Email Assistant
OWNER_NAME=
TIMEZONE=Asia/Kolkata
MAX_EMAILS_FETCH=50
CACHE_TTL_MINUTES=10
ENABLE_VOICE=true
LOG_LEVEL=INFO

# ---- Storage (defaults are fine for local dev) ----
DB_PATH=database/assistant.db
TOKEN_DIR=.tokens
