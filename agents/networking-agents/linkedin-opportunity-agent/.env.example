# ── LinkedIn Opportunity Agent — environment variables ──────────────────────────
# Copy this file to `.env` (local) or add the same keys to Streamlit Cloud
# "Secrets" (Settings → Secrets) when deploying.

# OpenAI API key — powers opportunity analysis, scoring, and outreach.
# Get one at https://platform.openai.com/api-keys . Without it the app still runs
# using a deterministic keyword-based fallback engine (less nuanced, no LLM cost).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for analysis. Default: gpt-4o-mini (fast / cheap for bulk scanning).
# For best quality use gpt-4o. Options: gpt-4o, gpt-4o-mini, gpt-4.1-mini.
LINKEDIN_AGENT_MODEL=gpt-4o-mini

# ── Optional: email digest delivery (SMTP) ──────────────────────────────────────
# Leave blank to preview digests in-app without sending real email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
ALERT_FROM=you@example.com
ALERT_TO=you@example.com
