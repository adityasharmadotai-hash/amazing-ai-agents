# ── LinkedIn Opportunity Agent — environment variables ──────────────────────────
# Copy this file to `.env` (local) or add the same keys to Streamlit Cloud
# "Secrets" (Settings → Secrets) when deploying.

# Anthropic Claude API key — powers opportunity analysis, scoring, and outreach.
# Get one at https://console.anthropic.com/ . Without it the app still runs using
# a deterministic keyword-based fallback engine (less nuanced, no LLM cost).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used for analysis. Default: claude-opus-4-8 (most capable).
# For high-volume / lower-cost scanning use claude-haiku-4-5 or claude-sonnet-4-6.
LINKEDIN_AGENT_MODEL=claude-opus-4-8

# ── Optional: email digest delivery (SMTP) ──────────────────────────────────────
# Leave blank to preview digests in-app without sending real email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
ALERT_FROM=you@example.com
ALERT_TO=you@example.com
