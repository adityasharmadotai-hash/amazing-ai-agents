# ── Required ─────────────────────────────────────────────────────────────
# Gemini (get one free at https://aistudio.google.com). Used by BOTH the news
# and LinkedIn extractors via agent/llm.py.
GEMINI_API_KEY=

# ── LinkedIn source: pick a backend, or merge them all ────────────────────
# "all"     = merge every provider you have a key for (SerpAPI + Apify +
#             Perplexity), run concurrently and dedupe — MAX COVERAGE (default).
# "serpapi" = Google-indexed posts (cheap, thin snippets, limited volume)
# "apify"   = real LinkedIn scrape (paid, full post text, much more volume)
# "perplexity" = Perplexity Search API — live web search, real LinkedIn URLs
# "gemini"  = Gemini/Google Search grounding — CANNOT find LinkedIn posts (0
#             results); excluded from "all". Kept only for completeness.
LINKEDIN_SOURCE=all

# SerpAPI (https://serpapi.com) — used when LINKEDIN_SOURCE=serpapi.
SERPAPI_KEY=

# Perplexity (https://www.perplexity.ai/settings/api) — used when
# LINKEDIN_SOURCE=perplexity. Key starts with `pplx-`. Billed per search.
PERPLEXITY_API_KEY=
# PERPLEXITY_COST_PER_SEARCH=0.006   # dashboard cost estimate per search

# Apify (https://apify.com, Settings -> Integrations -> API token) — used when
# LINKEDIN_SOURCE=apify. Pay-per-use; the default actor needs no LinkedIn login.
APIFY_TOKEN=
APIFY_ACTOR=apimaestro/linkedin-posts-search-scraper-no-cookies
# APIFY_DATE_FILTER=      # optional override, e.g. past-24h / past-week / past-month

# Location enrichment: when a post doesn't state the person's country, scrape
# their LinkedIn profile to resolve it before applying the US filter. This is
# what recovers US leads from "unknown location" posts. Costs one extra profile
# scrape per unknown-location software candidate. Set false to disable.
ENRICH_LOCATION=true
APIFY_PROFILE_ACTOR=apimaestro/linkedin-profile-detail

# Supabase — project URL + service_role key (Settings -> API).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Optional: enrichment (recruitment hand-off) ──────────────────────────
# Wiza API key (https://wiza.co). Without it, /enrich returns a clear error
# but the rest of the pipeline still works.
WIZA_API_KEY=

# ── Optional: news source ────────────────────────────────────────────────
# NewsAPI.org key. If empty, the news source is skipped (LinkedIn still runs).
NEWSAPI_KEY=

# ── Location + tuning knobs (safe defaults shown) ────────────────────────
# Target location filter. Default is San Francisco. Cities/regions/countries are
# allowed; separate multiple with | or ; (commas stay inside a place name).
# Leave blank for worldwide.
TARGET_LOCATIONS=San Francisco, California
LINKEDIN_RECENCY_DAYS=3       # search only the last N days (3 = default)
LINKEDIN_RESULTS_PER_Q=30     # results pulled per search per provider
APIFY_MAX_KEYWORD_VARIANTS=8  # max Apify keyword searches per scan (each is paid)
LOCATION_INCLUDE_UNKNOWN=true # keep posts whose location can't be determined
LOCATION_IN_SEARCH=false      # false = location filters only (broad); true = in query
GEMINI_MODEL=gemini-2.5-flash # cheap+fast; use gemini-2.5-pro for quality
SCAN_INTERVAL_HOURS=4         # scheduler cadence
# LINKEDIN_RECENCY=w          # legacy fallback (d/w/m/y) used only if _DAYS=0

# LINKEDIN_QUERIES — pipe-separated. Override to target specific companies or
# phrasings. Leave blank to use the built-in broad layoff-coverage query set.
LINKEDIN_QUERIES=
