# ── Required ─────────────────────────────────────────────────────────────
# Gemini (get one free at https://aistudio.google.com). Used by BOTH the news
# and LinkedIn extractors via agent/llm.py.
GEMINI_API_KEY=

# ── LinkedIn source: choose ONE backend ──────────────────────────────────
# "serpapi" = Google-indexed posts (cheap, thin snippets, limited volume)
# "apify"   = real LinkedIn scrape (paid, full post text, much more volume)
LINKEDIN_SOURCE=serpapi

# SerpAPI (https://serpapi.com) — used when LINKEDIN_SOURCE=serpapi.
SERPAPI_KEY=

# Apify (https://apify.com, Settings -> Integrations -> API token) — used when
# LINKEDIN_SOURCE=apify. Pay-per-use; the default actor needs no LinkedIn login.
APIFY_TOKEN=
APIFY_ACTOR=apimaestro/linkedin-posts-search-scraper-no-cookies
# APIFY_DATE_FILTER=      # optional override, e.g. past-24h / past-week / past-month

# Location enrichment: when a post doesn't state the person's country, scrape
# their LinkedIn profile to resolve it before applying the US filter. This is
# what recovers US leads from "unknown location" posts. Costs one extra profile
# scrape per unknown-location software candidate. Set false to disable.
ENRICH_LOCATION=true
APIFY_PROFILE_ACTOR=apimaestro/linkedin-profile-detail

# Supabase — project URL + service_role key (Settings -> API).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Optional: enrichment (recruitment hand-off) ──────────────────────────
# Wiza API key (https://wiza.co). Without it, /enrich returns a clear error
# but the rest of the pipeline still works.
WIZA_API_KEY=

# ── Optional: news source ────────────────────────────────────────────────
# NewsAPI.org key. If empty, the news source is skipped (LinkedIn still runs).
NEWSAPI_KEY=

# ── Optional tuning knobs (safe defaults shown) ──────────────────────────
LINKEDIN_RECENCY=w            # d = past day, w = week, m = month, y = year
LINKEDIN_RESULTS_PER_Q=20     # results pulled per search query
LAYOFF_US_ONLY=true           # true = restrict to US-based signals
GEMINI_MODEL=gemini-2.5-flash # cheap+fast; use gemini-2.5-pro for quality
SCAN_INTERVAL_HOURS=4         # scheduler cadence

# LINKEDIN_QUERIES — pipe-separated. Override to target specific companies /
# talent pools. Leave blank to use the built-in default query set.
LINKEDIN_QUERIES=
