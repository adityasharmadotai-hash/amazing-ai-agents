# Copy this file to `.streamlit/secrets.toml` for local runs, OR paste its
# contents into Streamlit Cloud → App → Settings → Secrets.
# Fill in the values and delete any optional lines you don't use.

# ── Required ────────────────────────────────────────────────
GEMINI_API_KEY = ""            # https://aistudio.google.com/app/apikey
SUPABASE_URL = ""              # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY = ""      # Supabase → Settings → API → service_role key

# ── LinkedIn backend: choose ONE ────────────────────────────
LINKEDIN_SOURCE = "serpapi"    # "serpapi" (cheap) or "apify" (full scrape)
SERPAPI_KEY = ""               # required if LINKEDIN_SOURCE = serpapi
APIFY_TOKEN = ""               # required if LINKEDIN_SOURCE = apify
APIFY_ACTOR = "apimaestro/linkedin-posts-search-scraper-no-cookies"

# ── Optional integrations ───────────────────────────────────
WIZA_API_KEY = ""              # enables the Enrich button (work email lookup)
NEWSAPI_KEY = ""               # adds a news-article source

# ── Search & targeting (optional — leave blank for defaults) ─
# Retarget the whole app without touching code. All three are editable from the
# in-app Settings page too.
TARGET_LOCATIONS = ""          # e.g. "United States, Canada"  (blank = worldwide, the default)
TARGET_TITLES = ""             # e.g. "Data Scientist, ML Engineer"  (blank = default SWE titles)
# One query per line. Use TOML triple-quotes for multiple lines. Blank = default set.
LINKEDIN_QUERIES = ""

# ── Tuning (safe defaults) ──────────────────────────────────
GEMINI_MODEL = "gemini-2.5-flash"
LINKEDIN_RECENCY = "w"
LINKEDIN_RESULTS_PER_Q = "20"
LAYOFF_US_ONLY = "false"       # false = worldwide (default); true = US-only
LOCATION_INCLUDE_UNKNOWN = "true"
ENRICH_LOCATION = "true"
